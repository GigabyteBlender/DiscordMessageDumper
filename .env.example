# Discord OAuth Configuration
# Get these values from https://discord.com/developers/applications

# Your Discord application's client ID
DISCORD_CLIENT_ID="your_client_id_here"

# Your Discord application's client secret
DISCORD_CLIENT_SECRET="your_client_secret_here"

# The redirect URI configured in your Discord application
# Default: http://localhost:8000/callback
DISCORD_REDIRECT_URI="http://localhost:8000/callback"

# OAuth scopes (space-separated)
# Default: identify email
DISCORD_SCOPE="identify email"

# Setup Instructions:
# 1. Copy this file to .env
# 2. Go to https://discord.com/developers/applications
# 3. Create a new application or select an existing one
# 4. Copy the Client ID and Client Secret
# 5. Add the redirect URI to OAuth2 settings
# 6. Replace the placeholder values above with your actual values
